{
  "name": "rek",
  "version": "0.8.1",
  "description": "Wrapper around the Fetch API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./dist/rek.js"
    }
  },
  "types": "./src/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "rm -r dist",
    "format": "oxfmt",
    "lint": "oxlint .",
    "prepare": "husky",
    "prepublishOnly": "npm run clean && npm run lint && npm run test && npm run build",
    "preversion": "npm run lint",
    "test": "tape tests/*"
  },
  "lint-staged": {
    "*.{cjs,js,mjs,ts}": "oxlint",
    "*.{cjs,js,json,mjs,ts}": "oxfmt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkmill/rek.git"
  },
  "keywords": [
    "ajax",
    "curl",
    "fetch",
    "fetching",
    "http",
    "https",
    "node-fetch",
    "request",
    "requests",
    "wget",
    "xhr"
  ],
  "author": "Linus Miller <lkm@lkm.nu> (https://lkm.nu/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lkmill/rek/issues"
  },
  "homepage": "https://github.com/lkmill/rek#readme",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "sinon": "^22.1.0",
    "tape": "^5.10.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
